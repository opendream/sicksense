# Local configuration (secrets, machine-specific overrides)
config/local.js

# Dependencies
node_modules
bower_components

# Sails / Grunt build output
.tmp

# Node / npm
lib-cov
*.seed
*.log
*.out
*.pid
npm-debug.log
coverage

# Editors and OS junk
*~
*#
.DS_Store
.idea
.vscode
.netbeans
nbproject
.node_history

# Orchestration logs (keep the directory)
.grok/orchestration/logs/*
!.grok/orchestration/logs/.gitkeep

# Local database dumps (may contain personal data) — never commit
tmp/
*.dump
*.dump.sql

# Local-only lockfile copies — never commit
npm-shrinkwrap.prod.json
